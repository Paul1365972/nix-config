// Tailnet policy for paul1365972.github — managed via GitOps, do not edit in the admin console.
// Tags: saber = tag:server + tag:exit, darkness = tag:server.
// Tailscale Services (svc:*) are defined via the Tailscale API (PUT /vip-services/svc:<name>) and served from saber via services.tailscale.serve.
{
    "tagOwners": {
        "tag:server": ["autogroup:admin"],
        "tag:exit":   ["autogroup:admin"],
    },

    "grants": [
        // My devices reach anything (each other, servers, exit-node internet, shared-in NAS).
        { "src": ["autogroup:member"], "dst": ["*"], "ip": ["*"] },
        // Server <-> server.
        { "src": ["tag:server"], "dst": ["tag:server"], "ip": ["*"] },
        // CLIProxyAPI VIP service.
        { "src": ["autogroup:member"], "dst": ["svc:cpamc"], "ip": ["tcp:8317"] },
        // Admin web UIs: tailnet-only, no public vhost and no forward-auth.
        {
            "src": ["autogroup:member"],
            "dst": ["svc:dashboard", "svc:matrix-admin", "svc:zigbee", "svc:maubot", "svc:home-assistant", "svc:traccar"],
            "ip":  ["tcp:443"],
        },
        // Taildrive: every device may use every device's shares.
        {
            "src": ["*"],
            "dst": ["*"],
            "app": { "tailscale.com/cap/drive": [{ "shares": ["*"], "access": "rw" }] },
        },
    ],

    "nodeAttrs": [
        { "target": ["autogroup:member"], "attr": ["funnel"] },
        // Tagged servers drop out of autogroup:member, so they're listed explicitly for Taildrive.
        { "target": ["autogroup:member", "tag:server"], "attr": ["drive:share", "drive:access"] },
    ],

    "ssh": [
        {
            "src":    ["autogroup:member"],
            "dst":    ["autogroup:self", "tag:server"],
            "users":  ["root", "autogroup:nonroot"],
            "action": "accept",
        },
    ],

    "autoApprovers": {
        "services": {
            "svc:cpamc":          ["tag:server"],
            "svc:dashboard":      ["tag:server"],
            "svc:matrix-admin":   ["tag:server"],
            "svc:zigbee":         ["tag:server"],
            "svc:maubot":         ["tag:server"],
            "svc:home-assistant": ["tag:server"],
            "svc:traccar":        ["tag:server"],
        },
        "exitNode": ["tag:exit"],
    },
}
